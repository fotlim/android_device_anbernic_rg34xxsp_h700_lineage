#
# ueventd.rg34xxsp.rc -- device node / sysfs permissions for the H700 handheld
#
# Only entries that differ from AOSP defaults or that this board needs at all
# belong here. Everything is 0660 + a meaningful group so that both the HAL
# (runs as `system`) and shell debugging can poke at them.

# --- backlight (pwm-backlight on PWM0 / PD28) --------------------------------
# No brightness-levels table in the DTS, so the scale is the driver default
# 0..255 -- the stock BSP's lcd_pwm_max_limit is likewise 0xff.
/sys/class/backlight/backlight/brightness      0660   system   system
/sys/class/backlight/backlight/max_brightness  0660   system   system

# --- gamepad / rumble (rocknix-singleadc-joypad) -----------------------------
/sys/devices/platform/rocknix-singleadc-joypad/rumble_enable  0660  system  system
/dev/input/event*                                             0660  system  input
/sys/class/input/input*/name                                  0440  system  input

# --- LEDs (power / status, PI12 / PI11) --------------------------------------
/sys/class/leds/led:power/brightness    0660  system  system
/sys/class/leds/led:status/brightness   0660  system  system

# --- Bluetooth (RTL8821CS over UART1, btrtl) ---------------------------------
/dev/rfkill                      0660  bluetooth  bluetooth
/sys/class/rfkill/rfkill*/state  0660  bluetooth  bluetooth
/sys/class/rfkill/rfkill*/type   0644  bluetooth  bluetooth
/dev/hci0                        0660  bluetooth  bluetooth

# --- HID over GATT (Bluetooth input devices) ---------------------------------
/dev/uhid                        0660  bluetooth  bluetooth

# --- Wi-Fi (rtw88 SDIO) ------------------------------------------------------
# The driver loads rtw88/rtw8821c_fw.bin from the in-kernel EXTRA_FIRMWARE
# blob, so no /vendor/firmware entry is needed here.
