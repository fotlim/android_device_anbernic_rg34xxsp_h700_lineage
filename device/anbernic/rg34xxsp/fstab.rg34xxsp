#
# SPDX-License-Identifier: Apache-2.0
#
# Android fstab for the Anbernic RG34XXSP.
# Used both as first-stage fstab (ramdisk) and, copied to vendor/etc, as the
# vendor fstab. Partitions are GPT and created by tools/mk-sdcard.sh, hence the
# by-name paths.
#
# <src>                                  <mnt_point>  <type>  <mnt_flags>                              <fs_mgr_flags>
#

# --- boot critical, non-logical ---------------------------------------------
/dev/block/by-name/metadata              /metadata    ext4    noatime,nosuid,nodev                     wait,formattable,first_stage_mount

# --- dynamic partitions inside "super" --------------------------------------
system                                   /system      ext4    ro,barrier=1                             wait,logical,first_stage_mount
system_ext                               /system_ext  ext4    ro,barrier=1                             wait,logical,first_stage_mount
product                                  /product     ext4    ro,barrier=1                             wait,logical,first_stage_mount
vendor                                   /vendor      ext4    ro,barrier=1                             wait,logical,first_stage_mount

# --- data -------------------------------------------------------------------
# FBE/ICE needs a working keymaster (== a TEE); the H700 has none, so this is a
# plain ext4 /data for now. If you later wire in a software keymaster, use
#   ...,fileencryption=software  and add keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/userdata              /data        ext4    noatime,nosuid,nodev,errors=panic         wait,check,quota,formattable,reservedsize=128M

# --- swap (zram, Android manages the device) --------------------------------
/dev/block/zram0                         none         swap    defaults                                 zramsize=75%,max_comp_streams=2