# SPDX-License-Identifier: Apache-2.0
#
# vendor.prop -- 落到 /vendor/build.prop 的属性（BoardConfig 里 TARGET_VENDOR_PROP 引入）
#
# 这些值是照着同代（Android 11）能跑的低内存设备调的，出处写在各段注释里。
#

# ------------------------------------------------------------------ 图形选择
# hw_get_module("hwcomposer") 先读 ro.hardware.hwcomposer，再按它去找
# /vendor/lib64/hw/hwcomposer.<值>.so。所以这里必须是模块名的后半段。
ro.hardware.hwcomposer=drm_minigbm
# mapper@4.0-impl.minigbm 是 passthrough，名字里的变体同样来自 ro.hardware
ro.hardware.gralloc=minigbm
# EGL：M1 先用 SwiftShader 顶上（external/swiftshader 的 libEGL_swiftshader，
# 取值沿用 goldfish fvp.mk 的写法）。真正吃 Mali-G31 的路线是 panfork-mesa，
# 但它要求 libdrm >= 2.4.109 + panfrost_drm.h，本树只有 2.4.99，升级工作
# 见 docs/PORTING.md §1。等 Mesa 进来后把这两行改成 mesa / panfrost。
ro.hardware.egl=swiftshader

# 内建固件在 /lib/firmware 由内核自身携带，不需要再配 firmware 路径

# --------------------------------------------------------------- 内存 / LMK
# 1 GiB 机器：让 LMK 更积极并按 minfree 分级，避免 SF 被系统回收
ro.lmk.use_minfree_levels=true
ro.lmk.use_new_strategy=true
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.upgrade_pressure=60
ro.lmk.log_stats=false
dalvik.vm.madvise-random=true

# ------------------------------------------------------------ SurfaceFlinger
# 720x480 只有 345k 像素，关掉客户端合成缓存省掉一大块显存
debug.sf.disable_client_composition_cache=1
# 3 个 buffer 足够双缓冲 + 一个 pending；4 个在 1 GiB 上没必要
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
# 首帧不预编译 shader，省启动时间和内存
service.sf.prime_shader_cache=0

# ------------------------------------------------------------------- 其它
wifi.interface=wlan0
drm.service.enabled=true
# 1 GiB 上 dex2oat 的默认策略太重
pm.dexopt.shared=quicken