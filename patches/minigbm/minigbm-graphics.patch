-			fd = open(node, O_RDWR, 0);
-			free(node);
-
-			if (fd < 0)
+			int fd = open(node, O_RDWR, 0);
+			if (fd < 0) {
+				free(node);
 				continue;
+			}
 
-			version = drmGetVersion(fd);
+			drmVersionPtr version = drmGetVersion(fd);
 			if (!version) {
 				close(fd);
+				free(node);
 				continue;
 			}
 
-			if (undesired[i] && !strcmp(version->name, undesired[i])) {
+			bool skip = false;
+			for (size_t i = 0; i < ARRAY_SIZE(undesired); i++) {
+				if (undesired[i] && !strcmp(version->name, undesired[i]))
+					skip = true;
+			}
+			drmFreeVersion(version);
+			if (skip) {
