+// The ramdisk carries fstab.<hardware> and first stage reads it straight off the
+// root filesystem.  SwitchRoot() then replaces / with the system image and
+// FreeRamdisk() deletes the ramdisk copy, so by the time second stage init and
+// vold look for a fstab again -- fs_mgr_read_fstab_default() only checks
+// /odm/etc, /vendor/etc and / -- there is none, /data never gets mounted, and
+// zygote dies creating /data/dalvik-cache.  Leave the same file in /vendor/etc
+// while /vendor is still reachable, before the ramdisk disappears.
+//
+// Two things here are learned the hard way:
+//   * LOG() is not evidence.  Userspace writes to /dev/kmsg are ratelimited by
+//     default ("printk.devkmsg=ratelimit"), and the sd32 run lost fifteen init
+//     lines in exactly this window.  So every step also appends to a receipt
+//     file on /metadata, which is a real filesystem and survives the reboot.
+//   * /vendor is mounted read-only, and a remount may be refused.  If it is,
+//     /vendor/etc is overlaid with a tmpfs upper layer instead -- the lowerdir
+//     is the directory itself, so nothing is hidden and the partition is never
+//     written.
+std::string g_publish_receipt;
+
+void pubnote(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void pubnote(const char* fmt, ...) {
+    char line[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    g_publish_receipt += line;
+    g_publish_receipt += '\n';
+    LOG(INFO) << "publish: " << line;
+}
+
+void pubflush() {
+    if (g_publish_receipt.empty()) return;
+    for (const char* path : {"/metadata/first-stage-publish.txt"}) {
+        int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+        if (fd < 0) {
+            PLOG(ERROR) << "Could not write the publish receipt to " << path;
+            continue;
+        }
+        const char* p = g_publish_receipt.data();
+        size_t left = g_publish_receipt.size();
+        while (left > 0) {
+            ssize_t n = write(fd, p, left);
+            if (n <= 0) break;
+            p += n;
+            left -= static_cast<size_t>(n);
+        }
+        fsync(fd);
+        close(fd);
+    }
+    sync();
+}
+
+bool PublishOne(const std::string& name, const std::string& content) {
+    std::string path = "/vendor/etc/" + name;
+    int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        pubnote("open %s failed: %d (%s)", path.c_str(), errno, strerror(errno));
+        return false;
+    }
+    const char* p = content.data();
+    size_t left = content.size();
+    ssize_t written = 0;
+    while (left > 0) {
+        ssize_t n = write(fd, p, left);
+        if (n <= 0) break;
+        p += n;
+        left -= static_cast<size_t>(n);
+        written += n;
+    }
+    fsync(fd);
+    close(fd);
+    bool ok = written == static_cast<ssize_t>(content.size());
+    pubnote("wrote %zd/%zu bytes to %s", written, content.size(), path.c_str());
+    return ok;
+}
+
+// Nothing in the shipped init rc ever runs mount_all, so /data stays unmounted
+// and post-fs-data works against the read-only system root. init imports every
+// *.rc under /vendor/etc/init, so a file published there -- next to the fstab,
+// on the same overlay -- is enough until vendor.img carries the mount_all
+// itself. "on fs" is where a default-mode mount_all has always belonged.
+const char kMountDataRc[] =
+    "# Written by first-stage init (patches/init-first-stage-publish-ramdisk-fstab).\n"
+    "#\n"
+    "# The device rc mounts nothing, so /data was never mounted and post-fs-data\n"
+    "# ran against the read-only system root: \"mkdir() failed on\n"
+    "# /data/dalvik-cache: Read-only file system\", zygote could not create its\n"
+    "# cache, and init gave up after four crashes. See meta-first-stage-publish.txt\n"
+    "# on /metadata for what this boot managed to publish.\n"
+    "on fs\n"
+    "    mount_all /vendor/etc/fstab.rg34xxsp\n";
+
+void PublishMountRc() {
+    const char* path = "/vendor/etc/init/99-mount-data.rc";
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        pubnote("rc: open %s failed: %d (%s)", path, errno, strerror(errno));
+        return;
+    }
+    size_t len = strlen(kMountDataRc);
+    ssize_t written = write(fd, kMountDataRc, len);
+    fsync(fd);
+    close(fd);
+    pubnote("rc: wrote %zd/%zu bytes to %s", written, len, path);
+}
+
+// zygote starts and then vanishes without a word in the kernel log: services
+// log to logd, and logd keeps its buffers in RAM. /dev/kmsg was the first
+// choice, but printk is slow enough that logd dropped hundreds of records
+// ("Skipping 182 entries from slow reader") and every line repainted the
+// panel through fbcon. /data/local/tmp is a real ext4 and debug-init picks it
+// up at the next boot, so write the log there and keep kmsg for the kernel.
+const char kFrameworkLogsRc[] =
+    "# Written by first-stage init (patches/init-first-stage-publish-ramdisk-fstab).\n"
+    "#\n"
+    "# zygote starts at 25.8 s and init kills its process group at 27.5 s with\n"
+    "# nothing from zygote in the kernel log, because services log to logd and\n"
+    "# logd's buffers die with the machine. Rewriting them into /dev/kmsg puts\n"
+    "# them where debug-init can copy them to the card before the panic lands.\n"
+    "on post-fs-data\n"
+    "    exec_background - root root -- /system/bin/logcat -b main -b system -b crash -v threadtime -r 4096 -n 2 -f /data/local/tmp/dsh-android.log\n";
+
+void PublishLogRc() {
+    const char* path = "/vendor/etc/init/98-framework-logs.rc";
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        pubnote("logrc: open %s failed: %d (%s)", path, errno, strerror(errno));
+        return;
+    }
+    size_t len = strlen(kFrameworkLogsRc);
+    ssize_t written = write(fd, kFrameworkLogsRc, len);
+    fsync(fd);
+    close(fd);
+    pubnote("logrc: wrote %zd/%zu bytes to %s", written, len, path);
+}
+
+/*
+ * The card the hardware composer opens.
+ *
+ * See external/drm_hwcomposer/drm/resourcemanager.cpp: the path comes from the
+ * hwc.drm.device property and defaults to /dev/dri/card0. Until sd39 card0 was
+ * the GPU's render-only node, where drmSetClientCap() answers -EOPNOTSUPP and
+ * the composer gives up. The kernel now gives card nodes to mode-setting
+ * drivers only; this property keeps the intent readable in the log either way.
+ */
+const char kGraphicsRc[] =
+    "# published by first-stage init (sd39)\n"
+    "# The composer opened panfrost's card and died on DRM_CLIENT_CAP_UNIVERSAL_PLANES.\n"
+    "# The display controller is the only card node on this board now.\n"
+    "on post-fs-data\n"
+    "    setprop hwc.drm.device /dev/dri/card0\n";
+
+void PublishGraphicsRc() {
+    const char* path = "/vendor/etc/init/97-graphics-device.rc";
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        pubnote("gfx: open %s failed: %d (%s)", path, errno, strerror(errno));
+        return;
+    }
+    size_t len = strlen(kGraphicsRc);
+    ssize_t written = write(fd, kGraphicsRc, len);
+    fsync(fd);
+    close(fd);
+    pubnote("gfx: wrote %zd/%zu bytes to %s", written, len, path);
+}
+
+void PublishRamdiskFstab(DIR* ramdisk) {
+    g_publish_receipt.clear();
+    int dfd = ramdisk ? dirfd(ramdisk) : -1;
+    pubnote("start, ramdisk=%p dirfd=%d (%s)", ramdisk, dfd,
+            dfd < 0 ? strerror(errno) : "ok");
+    if (dfd < 0) {
+        pubflush();
+        return;
+    }
+
+    std::vector<std::pair<std::string, std::string>> fstabs;
+    rewinddir(ramdisk);
+    while (dirent* de = readdir(ramdisk)) {
+        if (strncmp(de->d_name, "fstab.", 6) != 0) continue;
+        int fd = openat(dfd, de->d_name, O_RDONLY | O_CLOEXEC);
+        if (fd < 0) {
+            pubnote("openat %s failed: %d (%s)", de->d_name, errno, strerror(errno));
+            continue;
+        }
+        std::string content;
+        char buf[4096];
+        ssize_t n;
+        while ((n = read(fd, buf, sizeof(buf))) > 0) content.append(buf, n);
+        close(fd);
+        pubnote("found %s (%zu bytes)", de->d_name, content.size());
+        fstabs.emplace_back(de->d_name, std::move(content));
+
+        // A copy on /metadata as well, so a failed publish can be recovered
+        // and inspected without another build.
+        std::string backup = "/metadata/" + fstabs.back().first;
+        int bfd = open(backup.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+        if (bfd >= 0) {
+            write(bfd, fstabs.back().second.data(), fstabs.back().second.size());
+            fsync(bfd);
+            close(bfd);
+            pubnote("copied it to %s", backup.c_str());
+        } else {
+            pubnote("could not copy to %s: %d (%s)", backup.c_str(), errno,
+                    strerror(errno));
+        }
+    }
+
+    if (fstabs.empty()) {
+        pubnote("no fstab.* on the ramdisk, nothing to publish");
+        pubflush();
+        return;
+    }
+    if (access("/vendor/etc", F_OK) != 0) {
+        pubnote("no /vendor/etc: %d (%s)", errno, strerror(errno));
+        pubflush();
+        return;
+    }
+
+    // Route A: remount /vendor read-write for the duration.
+    bool published = false;
+    int rc = mount("/vendor", "/vendor", nullptr, MS_REMOUNT, nullptr);
+    pubnote("remount /vendor rw rc=%d errno=%d (%s)", rc, rc ? errno : 0,
+            rc ? strerror(errno) : "ok");
+    if (rc == 0) {
+        for (const auto& entry : fstabs) published |= PublishOne(entry.first, entry.second);
+        int rc2 = mount("/vendor", "/vendor", nullptr, MS_REMOUNT | MS_RDONLY, nullptr);
+        pubnote("remount /vendor ro rc=%d errno=%d (%s)", rc2, rc2 ? errno : 0,
+                rc2 ? strerror(errno) : "ok");
+    }
+
+    // Route B: overlay /vendor/etc with a tmpfs upper layer.
+    if (!published) {
+        mkdir("/dev/vendor_etc_upper", 0755);
+        mkdir("/dev/vendor_etc_work", 0755);
+        int rc3 = mount("overlay", "/vendor/etc", "overlay", 0,
+                        "lowerdir=/vendor/etc,upperdir=/dev/vendor_etc_upper,"
+                        "workdir=/dev/vendor_etc_work");
+        pubnote("overlay /vendor/etc rc=%d errno=%d (%s)", rc3, rc3 ? errno : 0,
+                rc3 ? strerror(errno) : "ok");
+        if (rc3 == 0) {
+            for (const auto& entry : fstabs) published |= PublishOne(entry.first, entry.second);
+        }
+    }
+
+    for (const auto& entry : fstabs) {
+        std::string path = "/vendor/etc/" + entry.first;
+        int seen = access(path.c_str(), R_OK);
+        pubnote("final access(%s)=%d (%s)", path.c_str(), seen,
+                seen == 0 ? "readable" : strerror(errno));
+    }
+    if (published) PublishMountRc();
+    if (published) PublishLogRc();
+    if (published) PublishGraphicsRc();
+    pubnote("done, published=%d", published ? 1 : 0);
+    pubflush();
+}
