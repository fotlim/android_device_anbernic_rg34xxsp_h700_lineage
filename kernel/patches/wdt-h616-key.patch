diff --git a/drivers/watchdog/sunxi_wdt.c b/drivers/watchdog/sunxi_wdt.c
index b6c761acc..4fc8f1d1b 100644
--- a/drivers/watchdog/sunxi_wdt.c
+++ b/drivers/watchdog/sunxi_wdt.c
@@ -226,6 +226,21 @@ static const struct sunxi_wdt_reg sun6i_wdt_reg = {
 	.wdt_reset_val = 0x01,
 };
 
+/*
+ * H616/H700: same register layout as sun6i-a31, but the mode and config
+ * registers only accept a write that carries the 0x16AA key in the top half.
+ * Without it every stop/start is silently dropped -- which is how this board
+ * ended up resetting itself 16 s into Android.
+ */
+static const struct sunxi_wdt_reg sun50i_h616_wdt_reg = {
+	.wdt_ctrl = 0x10,
+	.wdt_cfg = 0x14,
+	.wdt_mode = 0x18,
+	.wdt_timeout_shift = 4,
+	.wdt_reset_mask = 0x03,
+	.wdt_reset_val = 0x01,
+	.wdt_key_val = 0x16aa0000,
+};
 static const struct sunxi_wdt_reg sun20i_wdt_reg = {
 	.wdt_ctrl = 0x10,
 	.wdt_cfg = 0x14,
@@ -249,6 +264,7 @@ static const struct sunxi_wdt_reg sun55i_wdt_reg = {
 static const struct of_device_id sunxi_wdt_dt_ids[] = {
 	{ .compatible = "allwinner,sun4i-a10-wdt", .data = &sun4i_wdt_reg },
 	{ .compatible = "allwinner,sun6i-a31-wdt", .data = &sun6i_wdt_reg },
+	{ .compatible = "allwinner,sun50i-h616-wdt", .data = &sun50i_h616_wdt_reg },
 	{ .compatible = "allwinner,sun20i-d1-wdt", .data = &sun20i_wdt_reg },
 	{ .compatible = "allwinner,sun55i-a523-wdt", .data = &sun55i_wdt_reg },
 	{ /* sentinel */ }
