		i2c@7081400 {
			compatible = "allwinner,sun50i-h616-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x7081400 0x400>;
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x41 0x08>;
			dmas = <0x18 0x30 0x18 0x30>;
			dma-names = "rx\0tx";
			resets = <0x41 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x43>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0xa6>;

			pmic@34 {
				compatible = "x-powers,axp717";
				reg = <0x34>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-parent = <0x44>;
				interrupts = <0x00 0x08>;
				vin1-supply = <0x45>;
				vin2-supply = <0x45>;
				vin3-supply = <0x45>;
				vin4-supply = <0x45>;
				phandle = <0xa7>;

				adc {
					compatible = "x-powers,axp717-adc";
					#io-channel-cells = <0x01>;
					phandle = <0xa8>;
				};

				battery-power {
					compatible = "x-powers,axp717-battery-power-supply";
					monitored-battery = <0x46>;
					x-powers,no-thermistor;
					phandle = <0xa9>;
				};

				regulators {

					dcdc1 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x11b340>;
						regulator-name = "vdd-cpu";
						phandle = <0x05>;
					};

					dcdc2 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xea600>;
						regulator-name = "vdd-gpu-sys";
						phandle = <0x12>;
					};

					dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <0x10c8e0>;
						regulator-max-microvolt = <0x10c8e0>;
						regulator-name = "vdd-dram";
						phandle = <0xaa>;
					};

					aldo1 {
						phandle = <0xab>;
					};

					aldo2 {
						phandle = <0xac>;
					};

					aldo3 {
						phandle = <0xad>;
					};

					aldo4 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "avcc";
						phandle = <0x17>;
					};

					bldo1 {
						phandle = <0xae>;
					};

					bldo2 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pll";
						phandle = <0xaf>;
					};

					bldo3 {
						phandle = <0xb0>;
					};

					bldo4 {
						phandle = <0xb1>;
					};

					cldo1 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-spkr-amp";
						phandle = <0x27>;
					};

					cldo2 {
						phandle = <0xb2>;
					};

					cldo3 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-io";
						phandle = <0x16>;
					};

					cldo4 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-wifi";
						phandle = <0x1c>;
					};

					boost {
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4f5880>;
						regulator-name = "boost";
						phandle = <0x55>;
					};

					cpusldo {
						regulator-always-on;
						regulator-boot-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xdbba0>;
						phandle = <0xb3>;
					};
				};

				usb-power {
					compatible = "x-powers,axp717-usb-power-supply";
					input-current-limit-microamp = <0x16e360>;
					phandle = <0x2d>;
				};
			};

			rtc@51 {
				compatible = "nxp,pcf8563";
				reg = <0x51>;
				#clock-cells = <0x00>;
				phandle = <0xb4>;
			};
		};

		rsb@7083000 {
			compatible = "allwinner,sun50i-h616-rsb\0allwinner,sun8i-a23-rsb";
