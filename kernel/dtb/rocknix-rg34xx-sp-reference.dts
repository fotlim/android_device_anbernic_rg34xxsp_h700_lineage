	aliases {
		mmc0 = "/soc/mmc@4020000";
		mmc1 = "/soc/mmc@4022000";
		mmc2 = "/soc/mmc@4021000";
		serial0 = "/soc/serial@5000000";
		serial1 = "/soc/serial@5001400";
		rtc0 = "/soc/i2c@7081400/rtc@51";
		rtc1 = "/soc/rtc@7000000";
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0x4a 0x00 0x9c40 0x00>;
		pinctrl-0 = <0x4b>;
		pinctrl-names = "default";
		phandle = <0x50>;
	};

	battery {
		compatible = "simple-battery";
		constant-charge-current-max-microamp = <0xfa000>;
		voltage-max-design-microvolt = <0x401640>;
		phandle = <0x46>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {

			endpoint {
				remote-endpoint = <0x4c>;
				phandle = <0x31>;
			};
		};
	};

	rocknix-singleadc-joypad {
		compatible = "rocknix-singleadc-joypad";
		hw_info = <0x01>;
		joypad-name = "H700 Gamepad";
		joypad-product = <0x14df>;
		joypad-revision = <0x100>;
		joypad-vendor = <0x484b>;
		status = "okay";
		pwms = <0x4a 0x02 0xf4240 0x00>;
		pwm-names = "enable";
		rumble-boost-weak = <0x00>;
		rumble-boost-strong = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x4d 0x4e>;
		io-channel-names = "amux_adc";
		io-channels = <0x4f 0x00>;
		amux-count = <0x04>;
		amux-channel-mapping = <0x00 0x02 0x01 0x03>;
		amux-a-gpios = <0x1a 0x08 0x01 0x01>;
		amux-b-gpios = <0x1a 0x08 0x02 0x01>;
		button-adc-scale = <0x02>;
		button-adc-deadzone = <0x80>;
		button-adc-fuzz = <0x20>;
		button-adc-flat = <0x20>;
		abs_x-p-tuning = <0x46>;
		abs_x-n-tuning = <0x46>;
		invert-absx;
		abs_y-p-tuning = <0x46>;
		abs_y-n-tuning = <0x46>;
		invert-absy;
		abs_rx-p-tuning = <0x46>;
		abs_rx-n-tuning = <0x46>;
		abs_ry-p-tuning = <0x46>;
		abs_ry-n-tuning = <0x46>;
		poll-interval = <0x0a>;
		invert-absrx;
		invert-absry;
		phandle = <0xbc>;

		sw1 {
			gpios = <0x1a 0x00 0x06 0x01>;
			label = "GPIO DPAD-UP";
			linux,code = <0x220>;
		};

		sw2 {
			gpios = <0x1a 0x04 0x00 0x01>;
			label = "GPIO DPAD-DOWN";
			linux,code = <0x221>;
		};

		sw3 {
			gpios = <0x1a 0x00 0x08 0x01>;
			label = "GPIO DPAD-LEFT";
			linux,code = <0x222>;
		};

		sw4 {
			gpios = <0x1a 0x00 0x09 0x01>;
			label = "GPIO DPAD-RIGHT";
			linux,code = <0x223>;
		};

		sw5 {
			gpios = <0x1a 0x00 0x00 0x01>;
			label = "GPIO BTN-A";
			linux,code = <0x131>;
		};

		sw6 {
			gpios = <0x1a 0x00 0x01 0x01>;
			label = "GPIO BTN-B";
			linux,code = <0x130>;
		};

		sw7 {
			gpios = <0x1a 0x00 0x03 0x01>;
			label = "GPIO BTN-X";
			linux,code = <0x133>;
		};

		sw8 {
			gpios = <0x1a 0x00 0x02 0x01>;
			label = "GPIO BTN-Y";
			linux,code = <0x134>;
		};

		sw9 {
			gpios = <0x1a 0x00 0x05 0x01>;
			label = "BTN_SELECT";
			linux,code = <0x13a>;
		};

		sw10 {
			gpios = <0x1a 0x00 0x04 0x01>;
			label = "BTN_START";
			linux,code = <0x13b>;
		};

		sw11 {
			gpios = <0x1a 0x04 0x03 0x01>;
			label = "GPIO BTN_F";
			linux,code = <0x13c>;
		};

		sw12 {
			gpios = <0x1a 0x04 0x08 0x01>;
			label = "BTN_THUMBL";
			linux,code = <0x13d>;
		};

		sw13 {
			gpios = <0x1a 0x04 0x09 0x01>;
			label = "BTN_THUMBR";
			linux,code = <0x13e>;
		};

		sw14 {
			gpios = <0x1a 0x00 0x0c 0x01>;
			label = "GPIO BTN_TR";
			linux,code = <0x137>;
		};

		sw15 {
			gpios = <0x1a 0x00 0x07 0x01>;
			label = "GPIO BTN_TR2";
			linux,code = <0x139>;
		};

		sw16 {
			gpios = <0x1a 0x00 0x0a 0x01>;
			label = "GPIO BTN_TL";
			linux,code = <0x136>;
		};

		sw17 {
			gpios = <0x1a 0x00 0x0b 0x01>;
			label = "GPIO BTN_TL2";
			linux,code = <0x138>;
		};
	};

	gpio-keys-volume {
		compatible = "gpio-keys";
		autorepeat;

		button-vol-up {
			label = "Key Volume Up";
			gpios = <0x1a 0x04 0x01 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
		};

		button-vol-down {
			label = "Key Volume Down";
			gpios = <0x1a 0x04 0x02 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x72>;
		};
	};

	leds {
		compatible = "gpio-leds";
		phandle = <0xbd>;

		led-0 {
			function = "power";
			color = <0x02>;
			gpios = <0x1a 0x08 0x0c 0x00>;
			default-state = "on";
		};

		led-1 {
			function = "status";
			color = <0x01>;
			gpios = <0x1a 0x08 0x0b 0x00>;
		};
	};

	regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x45>;
	};

	regulator-gpio-lcd-vdd {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-name = "vdd-lcd";
		gpio = <0x1a 0x08 0x0f 0x00>;
		enable-active-high;
		phandle = <0x51>;
	};

	spi {
		compatible = "spi-gpio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		sck-gpios = <0x1a 0x08 0x09 0x00>;
		mosi-gpios = <0x1a 0x08 0x0a 0x00>;
		cs-gpios = <0x1a 0x08 0x08 0x00>;
		num-chipselects = <0x01>;
		phandle = <0xbe>;

		panel@0 {
			compatible = "anbernic,rg34xx-sp-panel\0panel-mipi-dpi-spi";
			reg = <0x00>;
			spi-max-frequency = <0x2faf08>;
			spi-3wire;
			reset-gpios = <0x1a 0x08 0x0e 0x01>;
			backlight = <0x50>;
			power-supply = <0x51>;
			pinctrl-0 = <0x52>;
			pinctrl-1 = <0x53>;
			pinctrl-names = "default\0sleep";
			phandle = <0xbf>;

			port {

				endpoint {
					remote-endpoint = <0x54>;
					phandle = <0x3c>;
				};
			};
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x13>;

		opp-420000000 {
			opp-hz = <0x00 0x1908b100>;
			opp-microvolt = <0xdbba0>;
		};

		opp-456000000 {
			opp-hz = <0x00 0x1b2e0200>;
			opp-microvolt = <0xdbba0>;
		};

		opp-504000000 {
			opp-hz = <0x00 0x1e0a6e00>;
			opp-microvolt = <0xdbba0>;
		};

		opp-552000000 {
			opp-hz = <0x00 0x20e6da00>;
			opp-microvolt = <0xdbba0>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xdbba0>;
		};

		opp-648000000 {
			opp-hz = <0x00 0x269fb200>;
			opp-microvolt = <0xea600>;
		};
	};

	regulator-vcc3v3-mmc2 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x1a 0x04 0x04 0x00>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3-mmc2";
		regulator-always-on;
		phandle = <0x1f>;
	};

	regulator-usb0-vbus {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x1a 0x08 0x10 0x00>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-name = "usb0-vbus";
		vin-supply = <0x55>;
		phandle = <0x2e>;
	};

	pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x14 0x01>;
		clock-names = "ext_clock";
		pinctrl-0 = <0x56>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <0x1a 0x06 0x12 0x01>;
		phandle = <0x1d>;
	};

	gpio-keys-lid {
		compatible = "gpio-keys";

		lid-switch {
			label = "Lid Switch";
			gpios = <0x1a 0x04 0x07 0x01>;
			linux,can-disable;
			linux,code = <0x00>;
			linux,input-type = <0x05>;
			wakeup-event-action = <0x02>;
			wakeup-source;
		};
	};

