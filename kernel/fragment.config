# SPDX-License-Identifier: Apache-2.0
#
# Kernel config fragment for the Anbernic RG34XXSP running Android.
#
# Merge with:
#   scripts/kconfig/merge_config.sh -m .config fragment.config
#
# Symbol names track the mainline 6.x tree the ROCKNIX H700 port uses; if a
# symbol is unknown on your kernel version, find its replacement in menuconfig
# instead of copying it blindly.
#

# ---------------------------------------------------------------- Android core
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# dma-buf heaps: the replacement for ION, used by the gbm gralloc + HWC
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y

# ------------------------------------------------------------------- display
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_HDMI=y
CONFIG_DRM_PANEL=y
# 面板：panel-mipi（kikuchan 通用 MIPI-DPI-over-SPI 驱动）+ spi-gpio 总线
CONFIG_DRM_PANEL_MIPI=y
CONFIG_DRM_MIPI_DBI=y
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
# 固件加载器：EXTRA_FIRMWARE 内建 panels/*.panel 需要它
CONFIG_FW_LOADER=y

# --------------------------------------------------------------------- input
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
# 手柄：树外模块 hackbar/rocknix-joypad（副本在 kernel/joypad/），
# build-kernel.sh 会把它放进 drivers/input/joystick/ 并插入同名 Kconfig 条目。
# 该符号没有上游定义，靠脚本注入；顺序错了 olddefconfig 会把它丢掉。
CONFIG_INPUT_ROCKNIX_SINGLEADC_JOYPAD=y
# 该驱动 rumble 用 input_ff_create_memless()
CONFIG_INPUT_FF_MEMLESS=y
# 摇杆走 IIO ADC（io-channels = <&gpadc 0>）
CONFIG_IIO=y

# --------------------------------------------------------------------- audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN50I_CODEC_ANALOG=y

# ----------------------------------------------------------------- wifi + bt
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_RTW88=y
CONFIG_RTW88_SDIO=y
CONFIG_RTW88_8821C=y
CONFIG_RTW88_8821CS=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_RTL=y

# ------------------------------------------------------------------- storage
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_MMC_BLOCK=y

# --------------------------------------------------------------- power / PMIC
# AXP717: MFD + regulator + charger + PEK. Names differ between kernel
# versions, verify in menuconfig.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_SUNXI_RSB=y

# ------------------------------------------------------------------- USB/ADB
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_ACC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y