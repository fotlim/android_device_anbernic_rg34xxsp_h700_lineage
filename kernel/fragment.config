# SPDX-License-Identifier: Apache-2.0
#
# Kernel config fragment for the Anbernic RG34XX SP running Android 11 (LineageOS 18.1).
#
# Used as:
#   scripts/kconfig/merge_config.sh -m .config kernel/fragment.config
#   make olddefconfig
# (tools/build-kernel.sh does exactly this, then asserts the symbols that matter.)
#
# Base is ROCKNIX's H700 linux.aarch64.conf -- a *Linux distro* config. Several
# things Android cannot live without are off in it (SELinux above all), so the
# point of this file is mostly "make an Android kernel out of a console kernel".
#
# Every symbol below was checked against the real 7.1.2 Kconfig tree; symbols
# this kernel version does not define are called out in a comment instead of
# being left in, because merge_config silently drops unknown ones and then you
# spend an evening wondering why your option did nothing.
#

# ---------------------------------------------------------------- Android core
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# ashmem 在 5.18 就从内核里删掉了，7.1.2 没有这个符号（写进去会被 olddefconfig 丢掉）。
# Android 11 的 libcutils 在 /dev/ashmem 不存在时会退回 memfd_create()，
# 所以需要的是 MEMFD_CREATE，不是 ASHMEM。
CONFIG_MEMFD_CREATE=y

# dma-buf heaps: the replacement for ION, used by the gbm gralloc + HWC
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CONFIGFS_FS=y

# --------------------------------------------------------------------- SELinux
# 这一块是本 fragment 存在的主要理由。ROCKNIX 的 base 是
#     CONFIG_DEFAULT_SECURITY_DAC=y
#     CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,bpf"   <-- 没有 selinux
# 而没有 SELinux 的 Android 根本起不来（init 第一件事就是装载策略）。
# 依赖链：SECURITY_SELINUX -> SECURITY_NETWORK && AUDIT && NET && INET。
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# 允许 androidboot.selinux=permissive —— bring-up 阶段救命，收敛后再关
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE=256
CONFIG_DEFAULT_SECURITY_SELINUX=y
# LSM 顺序必须显式带上 selinux，否则即使编进去了也不会被注册
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,ipe,bpf"

# ------------------------------------------------------------------- display
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_HDMI=y
CONFIG_DRM_PANEL=y
# 面板：panel-mipi（kikuchan 通用 MIPI-DPI-over-SPI 驱动）+ spi-gpio 总线
CONFIG_DRM_PANEL_MIPI=y
CONFIG_DRM_MIPI_DBI=y
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
# 固件加载器：EXTRA_FIRMWARE 内建 panels/*.panel 需要它
CONFIG_FW_LOADER=y

# --------------------------------------------------------------------- input
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
# 手柄：树外模块 hackbar/rocknix-joypad（副本在 kernel/joypad/），
# build-kernel.sh 会把它放进 drivers/input/joystick/ 并插入同名 Kconfig 条目。
# 该符号没有上游定义，靠脚本注入；顺序错了 olddefconfig 会把它丢掉。
CONFIG_INPUT_ROCKNIX_SINGLEADC_JOYPAD=y
# 该驱动 rumble 用 input_ff_create_memless()
CONFIG_INPUT_FF_MEMLESS=y
# 摇杆走 IIO ADC（io-channels = <&gpadc 0>）
CONFIG_IIO=y

# --------------------------------------------------------------------- audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN50I_CODEC_ANALOG=y

# ----------------------------------------------------------------- wifi + bt
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_RTW88=y
CONFIG_RTW88_SDIO=y
CONFIG_RTW88_8821C=y
CONFIG_RTW88_8821CS=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_HCIUART=y
# H4 是 UART 上的传输协议本体；ROCKNIX base 里它是关的（那台机器用 3-wire），
# 没有它 hci_uart 根本注册不出 h4 设备，btattach 会直接失败。
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_RTL=y
# Android 的蓝牙栈要 RFCOMM/BNEP/HIDP，且不能是 =m（Android 不装模块）
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# ------------------------------------------------------- netd / 防火墙 / 共享
# Android 11 的 netd 用的是 iptables(legacy)。Linux 7.x 把 iptables 拆成了
# legacy 与 nft 两套，关系是：
#     IP_NF_FILTER / IP_NF_NAT   depends on IP_NF_IPTABLES_LEGACY
#     IP_NF_IPTABLES_LEGACY      depends on NETFILTER_XTABLES_LEGACY
# 所以光设 IP_NF_IPTABLES=y 是不够的（它本身一直是对的），必须把 legacy 那层
# 显式打开，否则 FILTER/NAT/MASQUERADE 会全部被 olddefconfig 静默丢掉 ——
# 表现就是 Android 起来后没网、共享热点失败，而 dmesg 里什么都看不出来。
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
# IP_NF_TARGET_MASQUERADE 只是 "旧 iptables 的兼容入口"，真正干活的是 XT 那个
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
# Android 11 主要走 legacy iptables，但 =m 在 Android 上等于不可用，统一内建
CONFIG_NF_TABLES=y

# --- netd 的**启动**要求（和上面"跑起来要能用"是两回事）-------------------
# netd 在 main.cpp 里依次做 netlink/netfilter 探测，`Unable to create
# NFLogListener` 后面直接 exit(1)，所以这几项是**开机必需**，不是可选美化：
#   E Netd: Unable to create netlink socket for family 5: Protocol not supported
#   E Netd: Unable to create netlink socket for family 12: Protocol not supported
#   E Netd: Unable to create NFLogListener: Status[code: 93,
#           msg: "[Protocol not supported] : socket() failed"]
# netd 一死，netd.rc 的 `onrestart restart zygote[_secondary]` 就把两个 zygote
# 每 4~5 秒按死一次，system_server 永远起不来 —— 这是 sd56 之前真正的开机阻塞。
#
# 全部要 =y：本机没有 /lib/modules（init 日志 "Unable to open /lib/modules"），
# =m 等于没有。
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_LOG=y       # NFLOG，上面那条致命错误的来源
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_XFRM_USER=y                   # netd 的 XfrmController（缺了报错但继续跑）
# 不要写 CONFIG_NETFILTER_XT_TARGET_QUOTA2：这棵 7.1.2 树里没有这个 Kconfig
# 符号，也没有 net/netfilter/xt_quota2.c。netd 只会打一条 "Unable to open qlog
# quota socket" 的警告，写上反而会被 merge_config 静默丢掉、让人误以为开了。

# ------------------------------------------------------------------- storage
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y

# --------------------------------------------------------------- power / PMIC
# 本机 PMIC 实测是 AXP2202（sysfs 里就是 axp2202-dcdc3），mainline 没有专门驱动，
# ROCKNIX 按 AXP20X/AXP717 兼容路径带起来的。名字在不同内核版本间会变，改前先 menuconfig。
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_SUNXI_RSB=y

# ------------------------------------------------------------------- USB/ADB
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
# --------------------------------------------------------------------- quota
# fs_mgr turns the quota feature on for /data (tune2fs -Oquota) because the
# fstab entry says "quota". If the kernel cannot read those quotas the mount
# fails with EINVAL and ext4 is explicit about why:
#   EXT4-fs (mmcblk0p5): The kernel was not built with CONFIG_QUOTA and CONFIG_QFMT_V2
# Android kernels always carry QFMT_V2; this one did not.
CONFIG_QUOTA=y
CONFIG_QUOTA_TREE=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y